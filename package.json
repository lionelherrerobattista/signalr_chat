{
    "name": "signalr-chat",
    "private": true,
    "workspaces": [
        "frontend/signalr-chat"
    ],
    "scripts": {
        "dev": "npm-run-all --parallel dev:api dev:frontend",
        "dev:frontend": "npm run dev -w signalr-chat",
        "dev:api": "dotnet run --project backend/ChatApi/ChatApi.csproj",
        "build": "npm-run-all build:*",
        "build:frontend": "npm run build -w frontend",
        "build:api": "dotnet build backend/ChatApi/ChatApi.csproj"
    },
    "devDependencies": {
        "npm-run-all": "^4.1.5"
    }
}